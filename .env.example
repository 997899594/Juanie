# ============================================
# 数据库 (PostgreSQL)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=juanie
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password
DATABASE_SSL_MODE=disable
# 可选: 显式指定 Atlas scratch database（优先于平台默认推导）
# ATLAS_DEV_URL=
# ATLAS_DEV_URL_POSTGRESQL=
# ATLAS_DEV_URL_MYSQL=

# ============================================
# 认证配置 (NextAuth.js)
# ============================================
NEXTAUTH_SECRET=your-secret-key-at-least-32-characters
NEXTAUTH_URL=http://localhost:3000
# 本地无 Kubernetes Secret 自动引导时需要；生成示例: openssl rand -hex 32
# ENCRYPTION_MASTER_KEY=

# ============================================
# OAuth 配置
# ============================================
# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitLab OAuth (可选)
# GITLAB_CLIENT_ID=your-gitlab-client-id
# GITLAB_CLIENT_SECRET=your-gitlab-client-secret
# GITLAB_URL=https://gitlab.com

# 飞书 OAuth (可选，用于企业员工登录 Juanie，不参与 Git 执行授权)
# FEISHU_CLIENT_ID=cli_xxx
# FEISHU_CLIENT_SECRET=xxx
# FEISHU_ALLOWED_EMAIL_DOMAINS=example.com

# ============================================
# Redis 配置 (BullMQ 队列)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ============================================
# Kubernetes 配置
# ============================================
KUBECONFIG=~/.kube/config
# 或者直接使用内容
# KUBECONFIG_CONTENT=<base64-encoded-kubeconfig>

# ============================================
# 平台配置
# ============================================
NODE_ENV=development
PLATFORM_API_URL=http://localhost:3001
JUANIE_BASE_DOMAIN=juanie.art
JUANIE_ARGOCD_NAMESPACE=argocd
JUANIE_ARGOCD_PROJECT=juanie
JUANIE_ARGOCD_DESTINATION_SERVER=https://kubernetes.default.svc
JUANIE_PREVIEW_APPLICATIONSET_ENABLED=true
JUANIE_PREVIEW_APPLICATIONSET_REPO_URL=https://github.com/997899594/Juanie.git
JUANIE_PREVIEW_APPLICATIONSET_TARGET_REVISION=main
JUANIE_PREVIEW_APPLICATIONSET_PATH=deploy/k8s/charts/preview-scaffold
DEPLOY_REGISTRY=ghcr.io
DEPLOY_REGISTRY_PULL_SECRET_NAME=ghcr-pull-secret
# DEPLOY_REGISTRY_USERNAME=
# DEPLOY_REGISTRY_PASSWORD=

# ============================================
# 交付物对象存储（S3 兼容，可指向 AWS S3 / MinIO / R2）
# ============================================
# ARTIFACT_STORAGE_ENDPOINT=http://localhost:9000
# ARTIFACT_STORAGE_REGION=auto
# ARTIFACT_STORAGE_ACCESS_KEY_ID=
# ARTIFACT_STORAGE_SECRET_ACCESS_KEY=
# ARTIFACT_STORAGE_FORCE_PATH_STYLE=true
# ARTIFACT_DOWNLOAD_TTL_SECONDS=300

# ============================================
# 数据库控制台（可选，Bytebase Community）
# ============================================
# BYTEBASE_ENABLED=false
# BYTEBASE_URL=https://bytebase.juanie.art
# BYTEBASE_SQL_EDITOR_PATH=/sql-editor
# BYTEBASE_DATABASE_URL_TEMPLATE=
# 可选：不配置时 bootstrap 会用 CloudNativePG 自动创建 Bytebase 自身 metadata DB
# BYTEBASE_METADATA_DATABASE_URL=

# ============================================
# 历史保留 / 清理
# ============================================
ENABLE_HISTORY_RETENTION=true
HISTORY_RETENTION_SCHEDULE=17 */6 * * *
DEPLOYMENT_LOG_RETENTION_DAYS=14
AUDIT_LOG_RETENTION_DAYS=30
AI_PLUGIN_RUN_RETENTION_DAYS=14
AI_PLUGIN_SNAPSHOT_RETENTION_DAYS=30
MIGRATION_RUN_RETENTION_DAYS=30
SCHEMA_REPAIR_ATLAS_RUN_RETENTION_DAYS=30

# ============================================
# AI 配置 (302.ai)
# ============================================
AI_ENABLED=false
AI_302_API_KEY=
AI_302_BASE_URL=https://api.302ai.cn/v1
AI_DEFAULT_PLAN=free
AI_MODEL=gpt-5.2
AI_MODEL_PRO=gpt-5.2-pro
AI_MODEL_TOOL=gpt-5.2
