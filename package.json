{
  "name": "juanie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.9"
  },
  "scripts": {
    "dev": "concurrently -n web,worker,scheduler -c blue,green,magenta \"bun run dev:web\" \"bun run dev:worker\" \"bun run dev:scheduler\"",
    "dev:web": "bunx next dev --port 3001",
    "dev:worker": "tsx watch src/lib/queue/worker.ts",
    "dev:scheduler": "tsx watch src/lib/queue/scheduler.ts",
    "dev:redis": "docker start juanie-redis 2>/dev/null || docker run --name juanie-redis -p 6379:6379 -d redis:7-alpine",
    "build": "bunx next build --webpack",
    "start": "bunx next start",
    "start:worker": "bun src/lib/queue/worker.ts",
    "start:scheduler": "bun src/lib/queue/scheduler.ts",
    "lint": "bunx biome check src",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run ai:eval",
    "format": "bunx biome format src --write",
    "prepare": "bun scripts/prepare.ts",
    "test": "bun test",
    "ai:eval": "bun scripts/run-ai-evals.ts",
    "db:generate": "bun src/lib/db/control-plane-atlas.ts generate",
    "db:push": "bun src/lib/db/control-plane-atlas.ts apply",
    "db:hash": "bun src/lib/db/control-plane-atlas.ts hash",
    "db:status": "bun src/lib/db/control-plane-atlas.ts status",
    "db:validate": "bun src/lib/db/control-plane-atlas.ts validate",
    "db:studio": "bunx drizzle-kit studio --config drizzle.studio.config.ts",
    "bootstrap:k3s": "bash deploy/k8s/scripts/install-k3s.sh",
    "bootstrap:doctor": "bun scripts/bootstrap-doctor.ts",
    "db:seed": "tsx seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.68",
    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-s3": "^3.1064.0",
    "@aws-sdk/s3-request-presigner": "^3.1064.0",
    "@gitbeaker/rest": "^43.8.0",
    "@kubernetes/client-node": "^1.4.0",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@sentry/nextjs": "^10.56.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-form": "^1.33.0",
    "ai": "^6.0.198",
    "bullmq": "^5.78.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "mongodb": "^7.2.0",
    "mysql2": "^3.22.5",
    "nanoid": "^5.1.11",
    "next": "16.2.7",
    "next-auth": "5.0.0-beta.31",
    "octokit": "^5.0.5",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.19.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.9",
    "postcss": "^8.5.15",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
